# ==============================================================
# Algo Trader - Environment Variables (EXAMPLE / TEMPLATE)
# ==============================================================
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# Credentials are read from the environment only - never hardcoded in code.
# ==============================================================

# --- Kotak Neo market-data credentials (Phase 3) ---
# Consumer key: Kotak Neo app/web -> Invest -> Trade API card -> generate app.
KOTAK_NEO_CONSUMER_KEY=
# Optional consumer secret, if your Trade API app uses one.
KOTAK_NEO_CONSUMER_SECRET=
# Registered mobile number, including country code (e.g. +91XXXXXXXXXX).
KOTAK_NEO_MOBILE=
# Unique Client Code (profile section of the app/website).
KOTAK_NEO_UCC=
# 6-digit MPIN for your Neo account.
KOTAK_NEO_MPIN=
# TOTP: EITHER paste a current 6-digit code just before running...
KOTAK_NEO_TOTP=
# ...OR store the base32 TOTP secret and let pyotp generate codes (automation).
KOTAK_NEO_TOTP_SECRET=
# Environment: 'prod' (default) or 'uat'.
KOTAK_NEO_ENVIRONMENT=prod
# Optional neo_fin_key (tracking only).
KOTAK_NEO_FIN_KEY=
