# ==============================================================
# Algo Trader - Environment Variables (EXAMPLE / TEMPLATE)
# ==============================================================
# Copy this file to .env and fill in your real values:
#     cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# Credentials are read ONLY from the environment / this file at runtime.
# They never appear in source code, logs, tests, commits or docs.
# ==============================================================

# ----- Angel One SmartAPI (production market-data source) -----

# API key of your SmartAPI app.
# Where: https://smartapi.angelone.in -> log in -> "My Apps" ->
#        your app (the one created with the GitHub Pages redirect URL) ->
#        the "API Key" shown on the app card.
SMARTAPI_API_KEY=

# Your Angel One client code - the ID you use to log in to the
# Angel One trading app/website (e.g. of the form A123456).
# Where: Angel One app -> Profile, or your account-opening email.
SMARTAPI_CLIENT_CODE=

# Your Angel One login PIN (the 4-digit PIN used with the app login).
SMARTAPI_PIN=

# TOTP secret (base32 string) for SmartAPI two-factor auth.
# Where: https://smartapi.angelone.in/enable-totp -> log in with client
#        code + PIN -> an OTP is sent -> a QR code is shown. The QR
#        encodes the secret; use "copy the token/secret" below the QR
#        (or scan it and export the key from your authenticator app).
# With this set, logins are fully automatic (pyotp generates codes).
SMARTAPI_TOTP_SECRET=

# ALTERNATIVE to the secret: paste a current 6-digit code from your
# authenticator app just before running (expires in ~30 seconds).
# Leave empty if SMARTAPI_TOTP_SECRET is set.
SMARTAPI_TOTP=

# Optional: override the official instrument-master URL (rarely needed).
# SMARTAPI_INSTRUMENTS_URL=
