# ==============================================================
# Algo Trader - Environment Variables (EXAMPLE / TEMPLATE)
# ==============================================================
# Copy this file to .env and fill in real values only when needed:
#     cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
#
# Freqtrade maps any variable prefixed with FREQTRADE__ onto nested
# config keys, using a double underscore (__) as the level separator.
# These values OVERRIDE user_data/config.json at runtime.
# Docs: https://www.freqtrade.io/en/stable/configuration/#environment-variables
#
# IMPORTANT: The current setup runs in DRY-RUN mode, which does NOT
# require API keys. The variables below are only needed for
# authenticated / live features, which must NOT be enabled without
# explicit approval.
# ==============================================================

# --- Binance Spot API credentials (leave blank for dry-run) ---
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- Optional: Telegram notifications (disabled by default) ---
# FREQTRADE__TELEGRAM__ENABLED=false
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=

# --- Optional: REST API server (disabled by default) ---
# FREQTRADE__API_SERVER__ENABLED=false
# FREQTRADE__API_SERVER__USERNAME=
# FREQTRADE__API_SERVER__PASSWORD=
# FREQTRADE__API_SERVER__JWT_SECRET_KEY=
