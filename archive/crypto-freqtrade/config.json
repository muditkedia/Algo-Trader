{
    // ================================================================
    // Algo Trader - Binance Spot DRY-RUN configuration
    // ----------------------------------------------------------------
    // SAFETY: "dry_run" MUST remain true. Live trading must NOT be
    // enabled without explicit approval. No real API keys are stored
    // here - secrets are injected at runtime via environment variables
    // (see .env.example):
    //     FREQTRADE__EXCHANGE__KEY
    //     FREQTRADE__EXCHANGE__SECRET
    // Freqtrade supports // comments and trailing commas in this file.
    // ================================================================

    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",

    // --- Simulation only: no real orders are placed ---
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,

    "trading_mode": "spot",
    "margin_mode": "",

    "timeframe": "5m",

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "binance",
        // Keys intentionally blank - injected via env vars at runtime.
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    // --- Algo Trader framework configuration ---
    // Every value below is an OPTIONAL override of the defaults defined in
    // algo_core/settings.py (the single source of truth). Unknown keys are
    // ignored. The subset shown here mirrors the defaults; add any field from
    // IndicatorParams / EngineParams / RiskParams to tune it.
    "algo_trader": {
        "active_profile": "trend_following",
        "indicators": {
            "base_ema_fast": 9,
            "base_ema_slow": 21
        },
        "engine": {
            "min_score": 0.60,
            "adx_min_1h": 22,
            "adx_min_15m": 20
        },
        "risk": {
            "enable_risk_sizing": false,
            "risk_per_trade": 0.01,
            "hard_stop_pct": 0.06
        }
    },

    // Telegram and the REST API server are intentionally omitted while
    // disabled (an empty api_server.jwt_secret_key fails schema validation).
    // Enable them later via FREQTRADE__TELEGRAM__* / FREQTRADE__API_SERVER__*
    // environment variables (see .env.example) with real secrets.

    "bot_name": "algo-trader",
    "initial_state": "running",
    "force_entry_enable": false,

    "internals": {
        "process_throttle_secs": 5
    }
}
